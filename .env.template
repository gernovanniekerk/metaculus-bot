# =============================================================================
# Local runs only. Copy to `.env` (never commit it). In GitHub Actions, put the
# same names under Settings -> Secrets and variables -> Actions.
#
# EVERY key here must be from Gerno's PERSONAL accounts, paid with a personal
# card. Company accounts, cards or keys make the bot ineligible for prizes.
# See SETUP.md.
# =============================================================================

# ---- Required ----------------------------------------------------------------
# The BOT account's token (Metaculus -> Settings -> My Forecasting Bots).
METACULUS_TOKEN=REPLACE_ME

# Claude. Personal Anthropic Console key, ideally from a workspace with its own
# monthly spend limit.
ANTHROPIC_API_KEY=REPLACE_ME

# ---- Optional: Metaculus free LLM credits (arrive as an OpenRouter key) --------
# Used only when ANTHROPIC_API_KEY is empty, or when LLM_PROVIDER=openrouter.
# OPENROUTER_API_KEY=REPLACE_ME
# LLM_PROVIDER=auto

# ---- Research sources (set both if you can) ----------------------------------
# AskNews: free tournament quota for registered bot makers.
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
# or: ASKNEWS_API_KEY=REPLACE_ME
# Exa web search: pay per search (about 1 US cent per question).
# EXA_API_KEY=REPLACE_ME

# ---- Budget and models (defaults shown) --------------------------------------
# MONTHLY_BUDGET_USD=50
# MAX_USD_PER_QUESTION=1.50
# FULL_ENSEMBLE=claude-opus-5-5@medium*3,claude-sonnet-5-5@medium*2
# ECONOMY_ENSEMBLE=claude-sonnet-5-5@low*3
# PARSER_MODEL=claude-haiku-4-5
# MAX_OUTPUT_TOKENS=10000
# QUESTION_CONCURRENCY=2
